# ==========================================
# КОНФИГУРАЦИЯ MS SQL SERVER
# ==========================================
# Пароль для SA (администратора) - ОБЯЗАТЕЛЬНО измените!
# Должен быть сложным: минимум 8 символов, содержать заглавные/строчные/цифры/спецсимволы
MSSQL_SA_PASSWORD=StrongPass123!

# Редакция SQL Server: Developer (бесплатно для разработки), Evaluation, Express, Standard, Enterprise
MSSQL_PID=Developer

# Включить SQL Server Agent (нужен для автоматических задач)
MSSQL_AGENT_ENABLED=True

# ==========================================
# НАСТРОЙКИ DATABASE MAIL (SMTP)
# ==========================================
# ВНИМАНИЕ: Это настройки для отправки email-уведомлений из SQL Server
# Если не планируете использовать, оставьте закомментированными или с пустыми значениями

# SMTP сервер вашей компании (например: smtp.gmail.com, smtp.yandex.ru, smtp.office365.com)
SMTP_SERVER=smtp.gmail.com

# Порт SMTP (587 - TLS, 465 - SSL, 25 - без шифрования)
# Для Gmail используйте 587, для Office365 - 587
SMTP_PORT=587

# Email адрес, с которого будут отправляться письма (FROM)
SMTP_FROM_EMAIL=dwh-alerts@yourcompany.com

# Имя отправителя, которое будет видно в почтовом клиенте
SMTP_FROM_NAME=DWH Alert System

# Логин для SMTP аутентификации (обычно тот же email, что и FROM)
SMTP_USERNAME=smtp_user@yourcompany.com

# Пароль для SMTP аутентификации
# Для Gmail: используйте пароль приложения (App Password), а не основной пароль!
# Для Office365: используйте пароль учетной записи
SMTP_PASSWORD=YourSMTPPassword123!

# Email администратора, куда будут приходить уведомления об ошибках ETL
ADMIN_EMAIL=dwh-admin@yourcompany.com

# ==========================================
# НАСТРОЙКИ APACHE SUPERSET
# ==========================================
# Путь к конфигурационному файлу Superset внутри контейнера
SUPERSET_CONFIG_PATH=/app/pythonpath/superset_config.py

# Секретный ключ для Superset (сгенерируйте новый!)
# Команда для генерации: openssl rand -hex 32
SUPERSET_SECRET_KEY=bc0e844c141632e06745e97b9c11ed14ea1575a859a61045160de0e1e8fc5901

# ==========================================
# НАСТРОЙКИ ДЛЯ CI/CD (опционально)
# ==========================================
# Только для локальной разработки!
# В продакшене используйте Docker Secrets или Azure Key Vault

# Отключить проверку SSL сертификатов (только для тестов!)
# SQLCMD_TRUST_SERVER_CERTIFICATE=True

# Таймаут подключения к SQL Server (в секундах)
# SQLCMD_CONNECTION_TIMEOUT=30

# ==========================================
# ПРИМЕРЫ РАЗНЫХ SMTP ПРОВАЙДЕРОВ
# ==========================================
# Gmail:
#   SMTP_SERVER=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=your-email@gmail.com
#   SMTP_PASSWORD=your-app-password (16 символов, без пробелов)
#   Включить: enable_ssl=1, использовать пароль приложения

# Yandex:
#   SMTP_SERVER=smtp.yandex.ru
#   SMTP_PORT=587
#   SMTP_USERNAME=your-email@yandex.ru
#   SMTP_PASSWORD=your-password

# Mail.ru:
#   SMTP_SERVER=smtp.mail.ru
#   SMTP_PORT=587
#   SMTP_USERNAME=your-email@mail.ru
#   SMTP_PASSWORD=your-password
